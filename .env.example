# ==============================================================================
# LUMI KIDS (لُومِي) - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Target Platform: Android (Google Play Store)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' or add these variables to your Secrets / Environment
#    Variables panel in the AI Studio sidebar or cloud deployment settings.
# 2. Since Lumi Kids is dedicated exclusively to Android (Google Play), only the
#    VITE_ADMOB_*_ANDROID variables are required. iOS variables are optional/not needed.
# 3. In DEVELOPMENT: If missing, the app automatically falls back to Google's official
#    test AdMob IDs for safe local testing.
# 4. In PRODUCTION: Real Android AdMob IDs are REQUIRED. If not configured, ads are
#    automatically and completely DISABLED to prevent any store policy violations.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
APP_URL="https://lumi-kids-learning-2026.ai.studio"

# ------------------------------------------------------------------------------
# REQUIRED FOR ANDROID (Google Play Production)
# ------------------------------------------------------------------------------
# Notice:
# - App ID uses a TILDE (~): ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
# - Ad Unit IDs use a SLASH (/): ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# 1. Android Application ID (AdMob -> Apps -> App settings -> App ID)
VITE_ADMOB_APP_ID_ANDROID="ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx"

# 2. Android Banner Ad Unit ID (AdMob -> Ad units -> Banner)
VITE_ADMOB_BANNER_ID_ANDROID="ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx"

# 3. Android Interstitial Ad Unit ID (AdMob -> Ad units -> Interstitial - Optional)
VITE_ADMOB_INTERSTITIAL_ID_ANDROID="ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx"

# 4. Android Rewarded Ad Unit ID (AdMob -> Ad units -> Rewarded - Optional)
VITE_ADMOB_REWARDED_ID_ANDROID="ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx"

# ------------------------------------------------------------------------------
# OPTIONAL (iOS / Cross-Platform Fallbacks - Not needed for Android release)
# ------------------------------------------------------------------------------
VITE_ADMOB_APP_ID_IOS=""
VITE_ADMOB_BANNER_ID_IOS=""
VITE_ADMOB_INTERSTITIAL_ID_IOS=""
VITE_ADMOB_REWARDED_ID_IOS=""
